{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProgressiveSkillFixture",
  "description": "Minimal SKILL-02 prep schema for multi-chapter fixture layout",
  "type": "object",
  "required": ["name", "description", "chapters_dir"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "routing_keywords": { "type": "string" },
    "chapters_dir": { "type": "string", "minLength": 1 },
    "source_doc": { "type": "string" }
  }
}
