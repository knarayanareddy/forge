;; AetherForge Tool Sandbox Profile (sandbox_tool.sb)
(version 1)
(allow default)

(deny network*)

(deny file-write*
    (require-all
        (require-not (literal "/dev/null"))
        (require-not (subpath (param "WORKSPACE_PATH")))))

(deny file-read*
    (subpath "/etc")
    (subpath "/private/etc"))

;; Prevent reading other user data while retaining system runtime/framework reads.
(deny file-read*
    (require-all
        (subpath "/Users")
        (require-not (subpath (param "WORKSPACE_PATH")))))
